{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "MCP Connect",
		"description": "Connect Claude.ai, Claude Code, ChatGPT, Codex, Cursor and other AI clients to your site's MCP servers with a normal sign-in.",
		"author": "Alex Kirk",
		"categories": [
			"AI"
		]
	},
	"landingPage": "/wp-admin/tools.php?page=mcp-connect",
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/mcp-adapter/releases/latest/download/mcp-adapter.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "mcp-adapter"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/mcp-connect",
				"ref": "main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "mcp-connect"
			}
		}
	]
}
